{
  "description": "Doubled-word rule. Flag a word repeated back-to-back only if it is in flag_words. All other repeats (baby baby, no no no, run run run) are allowed as lyric style.",
  "flag_words": [
    "the",
    "a",
    "an",
    "to",
    "of",
    "in",
    "on",
    "at",
    "for",
    "from",
    "with",
    "by",
    "into",
    "and",
    "or",
    "but",
    "nor",
    "is",
    "are",
    "was",
    "were",
    "be",
    "been",
    "am",
    "will",
    "would",
    "can",
    "could",
    "should",
    "shall",
    "may",
    "might",
    "must"
  ],
  "never_flag_examples": [
    "had had",
    "that that",
    "do do do",
    "no no no",
    "baby baby",
    "oh oh"
  ],
  "case_insensitive": true,
  "ignore_across_line_breaks": true
}